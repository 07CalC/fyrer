  "keyFeatures": [
    "Concurrent task execution with topological dependency ordering",
    "Content-addressed local build cache with blake3 hashing and output restore",
    "Language-agnostic: works with any build tool or runtime",
    "Declarative YAML configuration with strict validation",
    "Interactive full-screen TUI with per-task log viewer",
    "Automatic .env file parsing at global, package, and task levels",
    "Per-task timeout, working directory, and environment overrides",
    "Graceful shutdown with SIGINT/SIGTERM handling"
  ],
  "publicApiSurface": [
